# secrets. JWT_SECRET belongs in the environment, never in the repository.
.env
.env.*
!.env.example

# browser automation profiles. .shot-profile-jira holds a signed-in Jira
# session; committing it would publish those cookies.
.shot-profile*/
.shot-diag*/