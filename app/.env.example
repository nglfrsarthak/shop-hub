# ShopHub runtime configuration.
#
# Copy to .env and edit, or just export these in your shell. Nothing here has a
# usable default on purpose: a service that starts with a known signing key is a
# service whose JWTs anybody can forge.

# Port the API and console listen on. Use 127.0.0.1, not localhost.
PORT=3000

# Signing key for session tokens. Required. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a session token stays valid.
JWT_TTL=2h

# SQLite file. Relative paths resolve against the app/ directory.
DB_PATH=./data/shop.db

# Set either to true to load demo data into an empty database. Leave unset in
# anything you care about: it creates accounts whose password is documented.
DB_SEED=false
AUTO_SEED=false

# Request logging to stdout, one JSON object per line. On by default unless
# NODE_ENV=test.
LOG_REQUESTS=true